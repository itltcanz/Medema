<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<Tab
  xmlns="http://javafx.com/javafx/javafx"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="dev.itltcanz.medema.controller.DetectorTabController"
  closable="false"
  text="Детекторы"
>
  <VBox>
    <TableView fx:id="detectorTableView" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="detectorIdColum" text="Id"/>
        <TableColumn fx:id="detectorIpColum" text="Ip"/>
        <TableColumn fx:id="detectorPortColum" text="Port"/>
        <TableColumn fx:id="detectorLocationColum" text="Локация"/>
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
    </TableView>
    <HBox styleClass="inputsContainer">
      <TextField fx:id="detectorIdTextField" promptText="Id"/>
      <TextField fx:id="detectorIpTextField" promptText="Ip"/>
      <TextField fx:id="detectorPortTextField" promptText="Port"/>
      <ComboBox fx:id="detectorLocationComboBox" promptText="Локация"/>

    </HBox>
    <HBox styleClass="buttonsContainer">
      <Button onAction="#createDetector" text="Создать"/>
      <Button onAction="#updateDetector" text="Изменить"/>
      <Button onAction="#deleteDetector" text="Удалить"/>
      <Button onAction="#updateDetectorTable" text="Обновить"/>
      <Button onAction="#clearDetectorInputs" text="Очистить"/>
    </HBox>
  </VBox>
</Tab>
