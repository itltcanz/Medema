<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<Tab
  xmlns="http://javafx.com/javafx/javafx"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="dev.itltcanz.medema.controller.LocationTabController"
  closable="false"
  text="Локации"
>
  <VBox>
    <TableView fx:id="locationTableView" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="locationIdColum" text="Id"/>
        <TableColumn fx:id="locationNameColum" text="Название"/>
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
    </TableView>
    <HBox styleClass="inputsContainer">
      <TextField fx:id="locationIdTextField" promptText="Id" editable="false"/>
      <TextField fx:id="locationNameTextField" promptText="Название"/>
    </HBox>
    <HBox styleClass="buttonsContainer">
      <Button onAction="#createLocation" text="Создать"/>
      <Button onAction="#updateLocation" text="Изменить"/>
      <Button onAction="#deleteLocation" text="Удалить"/>
      <Button onAction="#updateLocationTable" text="Обновить"/>
      <Button onAction="#clearLocationInputs" text="Очистить"/>
    </HBox>
  </VBox>
</Tab>
