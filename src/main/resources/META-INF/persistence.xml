<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence
  xmlns="https://jakarta.ee/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
  version="3.0"
>

  <persistence-unit name="medema-unit" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>dev.itltcanz.medema.model.entity.Detector</class>
    <class>dev.itltcanz.medema.model.entity.Scan</class>
    <class>dev.itltcanz.medema.model.entity.Location</class>

    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:medema.db"/>
      <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>

      <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
      <property name="hibernate.hikari.dataSource.foreign_keys" value="true"/>
      <property name="hibernate.hikari.connectionTimeout" value="10000"/>
      <property name="hibernate.hikari.maximumPoolSize" value="2"/>
      <property name="hibernate.hikari.minimumIdle" value="1"/>
      <property name="hibernate.hikari.idleTimeout" value="30000"/>
      <property name="hibernate.hikari.maxLifetime" value="600000"/>
    </properties>
  </persistence-unit>
</persistence>